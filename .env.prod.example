# ================================
# 生产环境模板 — 复制为 .env.prod 后填入真实密钥
# cp .env.prod.example .env.prod
# ================================

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# 阿里云百炼 AI (DashScope)
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# PostgreSQL（生产请使用强密码与内网地址）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# 对象存储
APP_STORAGE_ENDPOINT=http://minio:9000
APP_STORAGE_ACCESS_KEY=change_me_access_key
APP_STORAGE_SECRET_KEY=change_me_secret_key
APP_STORAGE_BUCKET=interview-guide

# AI 模型
AI_MODEL=qwen-plus

# CORS（生产前端域名）
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ================================
# Langfuse（生产：低采样；默认不记录 prompt 内容）
# 填入密钥后将 LANGFUSE_ENABLED=true
# ================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_SAMPLING_PROBABILITY=0.2
LANGFUSE_LOG_PROMPT=false
LANGFUSE_LOG_COMPLETION=false
LANGFUSE_INCLUDE_ERROR_LOGGING=false
LANGFUSE_LOG_TOOL_CONTENT=false
LANGFUSE_LOG_VECTORSTORE_RESPONSE=false
