# ================================
# 开发环境模板 — 复制为 .env.dev 后填入真实密钥
# cp .env.dev.example .env.dev
# ================================

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS
AI_BAILIAN_API_KEY=sk-76eec6f629024302bcc10f01a13f98d4

# PostgreSQL（与 docker-compose 本地依赖对齐）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide

# AI 模型
AI_MODEL=qwen-plus

# ================================
# Langfuse（开发：全采样 + 记录更多 AI 观测字段）
# 填入密钥后将 LANGFUSE_ENABLED=true
# ================================
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
# EU Cloud（Spring Boot 需完整 /v1/traces 路径）
# LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# US: https://us.cloud.langfuse.com/api/public/otel/v1/traces
# Self-hosted:
LANGFUSE_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
LANGFUSE_SAMPLING_PROBABILITY=1.0
LANGFUSE_LOG_PROMPT=true
LANGFUSE_LOG_COMPLETION=true
LANGFUSE_INCLUDE_ERROR_LOGGING=true
LANGFUSE_LOG_TOOL_CONTENT=true
LANGFUSE_LOG_VECTORSTORE_RESPONSE=true
