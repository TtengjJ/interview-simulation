# ================================
# 环境变量说明
# ================================
#
# 本项目按环境拆分配置文件（密钥勿提交 Git）：
#
#   cp .env.dev.example  .env.dev     # 本地开发
#   cp .env.prod.example .env.prod    # 生产部署
#
# 启动后端：
#   ./gradlew bootRun                 # 默认加载 .env.dev
#   ./gradlew bootRun -Penv=prod      # 加载 .env.prod
#
# 详细字段见 .env.dev.example / .env.prod.example
# ================================

# 兼容旧流程：仍可使用单一 .env（bootRun 在找不到 .env.${env} 时回退）
AI_BAILIAN_API_KEY=your_dashscope_api_key_here
